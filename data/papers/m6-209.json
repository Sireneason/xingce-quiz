87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-31b1b96603ec3e23.png\" />和 <img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-82286f94757b40ce.png\" />两个分数比较，<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-31b1b96603ec3e23.png\" />的分子大分母小，分数一定大，说明轿车<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ce99f935fdbe4b33.png\" />SUV，排除B、D项。剩余A、C项，只需要比较交叉型乘用车和MPV的销量，2017年1-9月MPV销量为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-151a70b9d094d43d.png\" />万辆，交叉型乘用车销量为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-c0f2607afe17701e.png\" />万辆，<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-151a70b9d094d43d.png\" />和<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-c0f2607afe17701e.png\" />比较，分母十分接近，MPV的分子远远大于交叉型乘用车，因此MPV<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ce99f935fdbe4b33.png\" />交叉型乘用车，排除A项。</p><p>故正确答案为C。</p>"},{"n":5,"qid":"2385135","tag":"综合","type":"single","stem":"根据上文，以下说法一定正确的是（    ）。","opts":[{"k":"A","t":"2017年1-9月，纯电动汽车和插电式混合动力汽车的产量均高于自身销量"},{"k":"B","t":"2017年1-9月，货车销量是客车销量的9.7倍"},{"k":"C","t":"2018年1-9月，非中国品牌乘用车销量同比下降"},{"k":"D","t":"2018年1-9月，乘用车与商用车的整车出口量差距同比进一步扩大"}],"ans":["A"],"missing":false,"analysis":"<p>A项：定位材料第四段，纯电动汽车产销分别完成55.5万辆和54.1万辆，同比分别增长<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-235cf4f2bc3c47fe.png\" />和<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-650748a5c8dc073b.png\" />；插电式混合动力汽车产销分别完成18.0万辆和18.1万辆，同比分别增长<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-c89aaf61197f15c4.png\" />和<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-3e7ffdc8c48637a7.png\" />。2017年1-9月纯电动汽车产量为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ed08ca0001530136.png\" />万辆；销量为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-c7ad940d1d6d2693.png\" />万辆，产量对应分子大，分母小，明显结果更大；2017年1-9月插电式混合动力汽车产量为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-04593941a3b1d489.png\" />万辆；销量为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-37d4cfe2b95649df.png\" />万辆，二者分子几乎相等，而产量对应分母更小，因此结果也更大，正确；</p><p>B项：定位材料第三段，可得：客车销量为33.3（B）万辆，同比下降<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-c6e3e77eda09a254.png\" />（b）；货车销量289.8（A）万辆，同比增长<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-3ae963a4387a3a4a.png\" />（a）。根据基期倍数公式<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-d95fbb3309ed8dfc.png\" />，货车销量是客车销量的<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-23e9ad6fdb7ac110.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-069d9f7f48dd5bbc.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-57d52219b15996dd.png\" />倍，错误；</p><p>C项：定位材料第二段，2018年1-9月，乘用车累计销量同比增长0.6%，中国品牌乘用车累计销售同比下降<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-f2df88838b37eec6.png\" />，因为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-394fb42171816a97.png\" />，根据混合增长率居中，可知整体增长率<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-2bac74ab2bc406d6.png\" />大于中国品牌乘用车销量同比增长率（<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-9cd1866309eff276.png\" />），必然小于非中国品牌乘用车销量同比增长率，即2018年1-9月，非中国品牌乘用车销量同比增长率大于<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-2bac74ab2bc406d6.png\" />，并非同比下降，错误；</p><p>D项：定位材料第五段，可得：乘用车出口60.1万辆，同比增长<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-f8461de9467c749d.png\" />；商用车出口21.3万辆，同比增长<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-bc07af1df49fe1e5.png\" />。题干“2018年1-9月，乘用车与商用车的整车出口量差距同比进一步扩大”，同比进一步扩大，是指2017年比2016年扩大，2018年又比2017年扩大，而根据材料无法求出2016年的整车出口量差距数据，所以无法推断，错误。</p><p>故正确答案为A。</p>"}]},{"material":"<p><img src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E9%A2%98%E7%9B%AE%E5%9B%BE/16aabbb09b7703c.png\" /></p>","qs":[{"n":6,"qid":"2385100","tag":"综合","type":"single","stem":"2011年，深圳市进出口总额为（    ）亿美元。","opts":[{"k":"A","t":"4877.41"},{"k":"B","t":"4668.31"},{"k":"C","t":"4142.24"},{"k":"D","t":"3984.39"}],"ans":["C"],"missing":false,"analysis":"<p>由题干“2011年，深圳市进出口总额为（    ）亿美元”且材料时间是2012年，判定此题为基期计算问题。定位统计图，根据公式：<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-60a5c217b6fe5197.png\" />，则2011年深圳市进出口总额为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-9d771d1c121b62ea.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-e0a01ca285cc3945.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-e53657e3b3c635d1.png\" />亿美元，与C项最接近。</p><p>故正确答案为C。</p>"},{"n":7,"qid":"2385101","tag":"综合","type":"single","stem":"2012-2017年，深圳市进出口贸易顺差最大的年份是（    ）年。","opts":[{"k":"A","t":"2012"},{"k":"B","t":"2014"},{"k":"C","t":"2015"},{"k":"D","t":"2017"}],"ans":["C"],"missing":false,"analysis":"<p>定位材料可知，2012年深圳市进出口贸易顺差为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-a6ebd38d8d3a8ae3.png\" />亿美元；2014年深圳市进出口贸易顺差为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-5b3bd310745075f6.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-2564004314aef4f5.png\" />亿美元；2015年深圳市进出口贸易顺差为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-70673cab2a57c7a6.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-d353936c101af933.png\" />亿美元；2017年深圳市进出口贸易顺差为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-1492b306106f8674.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-c2e5efc894d36d25.png\" />亿美元。因此，深圳市进出口贸易顺差最大的年份是2015年。（只计算选项中给的年份即可）</p><p>故正确答案为C。</p>"},{"n":8,"qid":"2385105","tag":"增长","type":"single","stem":"2012-2017年，深圳市进出口总额同比增幅最大的年份和同比减幅最大的年份相比，其进口总额相差（    ）亿美元。","opts":[{"k":"A","t":"1390.35"},{"k":"B","t":"982.01"},{"k":"C","t":"708.80"},{"k":"D","t":"681.55"}],"ans":["C"],"missing":false,"analysis":"<p>由材料可知深圳市进出口总额同比增幅最大的年份为2013年（<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-8fd6451e61f084ad.png\" />），降幅最大的年份为2016年（<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-971593319237269f.png\" />），其进口总额相差<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-f5d779872addce1a.png\" />亿美元。</p><p>故正确答案为C。</p>"},{"n":9,"qid":"2385115","tag":"增长","type":"single","stem":"2012-2017年，深圳市进口总额的年均增长率约为（    ）。","opts":[{"k":"A","t":"<p><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-80508be512e074cb.png\" /></p>"},{"k":"B","t":"<p><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-d0198759d14bd76a.png\" /></p>"},{"k":"C","t":"<p><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-041f74d04bd15f94.png\" /></p>"},{"k":"D","t":"<p><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-aebd2383ccee34cc.png\" /></p>"}],"ans":["A"],"missing":false,"analysis":"<p>由题干“2012-2017年，深圳市进口总额的年均增长率约为（）”判定此题为年均增长率问题。根据公式：<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-a04b1b98e97e1174.png\" />，由材料可知，<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-c5607ee747c001a6.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-3eae734b0c369188.png\" />，结合选项增长率数值较小，根据<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-b270398a010db66d.png\" />进行估算，则有1+5r＜0.87，解得r＜-2.6%，只有A项略小于-2.6%。</p><p>故正确答案为A。</p>"},{"n":10,"qid":"2385119","tag":"综合","type":"single","stem":"根据上图，下列说法正确的是（    ）。","opts":[{"k":"A","t":"2013-2017年，深圳市进出口总额呈先升后降的趋势"},{"k":"B","t":"2013年深圳市出口总额是2017年进口总额的2倍多"},{"k":"C","t":"2013-2017年，深圳市进出口总额的同比增速均高于本年出口总额的同比增速"},{"k":"D","t":"2017年，深圳市进出口总额同比增加157.07亿美元"}],"ans":["D"],"missing":false,"analysis":"<p>A项：观察折线图可知，2017年进出口总额同比增长<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-752a49e89398b2ed.png\" />，即2017年进出口总额高于2016年，并不是下降。错误；</p><p>B项：由材料可知，2013年深圳市出口额为3057.02亿美元，2017年深圳市进口额为1697.88亿美元，<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-b3cbc9cec33fe15d.png\" />，不足2倍。错误；</p><p>C项：由折线图可知2014年深圳市进出口总额增速为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-08074b24ae5cd627.png\" />，出口额增速为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-548e37bb7200a4ad.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-9fe0fa85844069e6.png\" />，即2014深圳市进出口总额的同比增速低于本年出口总额的同比增速。错误；</p><p>D项：2017年深圳市进出口总额同比增长<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-848b5009fabe4dfa.png\" />亿美元。正确。</p><p>故正确答案为D。</p>"}]},{"material":"<p><img src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E9%A2%98%E7%9B%AE%E5%9B%BE/16aab9bd94b82ba.png\" /></p>","qs":[{"n":11,"qid":"2385093","tag":"增长","type":"single","stem":"2018年，广东省生产总值同比增长（    ）。","opts":[{"k":"A","t":"<p><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-53c52b31eb78e6ae.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-f15857b3d3a081e0.png\" /></p>"},{"k":"B","t":"<p><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-c18609254a584423.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-f15857b3d3a081e0.png\" /></p>"},{"k":"C","t":"<p><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-4791aa83c8711bce.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-f15857b3d3a081e0.png\" /></p>"},{"k":"D","t":"<p><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-7cfa3f271033f906.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-f15857b3d3a081e0.png\" /></p>"}],"ans":["A"],"missing":false,"analysis":"<p>由题干“2018年，广东省生产总值同比增长”，结合选项为百分数，可判定本题为增长率计算问题。定位表2可得，2018年珠三角地区、粤东西北地区生产总值分别为81048.50、19977.45亿元，2017年分别为75809.75、19345.38亿元。根据文字部分可知，粤东西北地区是指广东省除珠三角地区之外的所有地区，则2018年广东省生产总值同比增长率为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-0c21e082829c03f6.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-d1a49896c0c290c0.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-371eb51f08cee045.png\" /></p><p>故正确答案为A。</p>"},{"n":12,"qid":"2385096","tag":"比重","type":"single","stem":"2016年，珠三角地区下列经济指标占全省总额的比重，与珠三角地区生产总值占全省生产总值的比重最接近的是（    ）。","opts":[{"k":"A","t":"固定资产投资"},{"k":"B","t":"房地产开发投资"},{"k":"C","t":"社会消费品零售总额"},{"k":"D","t":"进出口总额"}],"ans":["B"],"missing":false,"analysis":"<p>由题干“2016年···占···的比重，与···占···的比重最接近的是”，可判定本题为现期比重比较问题。定位表2可得，2016年珠三角地区、粤东西北地区生产总值分别为67841.85、17713.81亿元，则珠三角地区生产总值占全省生产总值的比重为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-c724ecdb54b5fb49.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-80049e6684918da3.png\" />。定位表1可得2016年广东各区域主要经济总量指标，分别计算珠三角所占比重即可。</p><p>A固定资产投资：<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ec6d91bdad7b70b2.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-5d62441ebf0298b1.png\" />；</p><p>B房地产开发投资：<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-acd27cdad1397fb0.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-d592512a6b7a177f.png\" />；</p><p>C社会消费品零售总额：<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-02a740b708dbe2f5.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-4bf1a691cc6333ad.png\" />；</p><p>D进出口总额：<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-c43b64ac90019a02.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-16f63cf38e18dca1.png\" />。</p><p>比较可知，与珠三角地区生产总值占全省生产总值的比重最接近的是房地产开发投资。</p><p>故正确答案为B。</p>"},{"n":13,"qid":"2385097","tag":"增长","type":"single","stem":"2013-2018年，粤东西北地区生产总值同比增速最快的年份是（    ）年。","opts":[{"k":"A","t":"2013"},{"k":"B","t":"2014"},{"k":"C","t":"2017"},{"k":"D","t":"2018"}],"ans":["A"],"missing":false,"analysis":"<p>由题干“2013-2018年···同比增速最快的年份是”，可判定本题为增长率比较问题。定位表2可得，2012-2018年粤东西北地区生产总值，根据<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-bbe755620710d0fd.png\" />计算各选项年份增长率，进行比较即可。</p><p>A:2013年：<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-b3b10248a41b36e7.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-38769954529d1e09.png\" />；</p><p>B:2014年：<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-80c001ae7d07de1f.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-32f489de0b489c50.png\" />；</p><p>C:2017年：<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-8075daa15fe1425d.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-9a5a9ca0849a52e7.png\" />；</p><p>D:2018年：<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ff470496c8376ff6.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-b0a7776afec6c5cd.png\" />。</p><p>比较可知，粤东西北地区生产总值同比增速最快的年份是2013年。</p><p>故正确答案为A。</p><p>备注：本题按照网友回忆版题干为“2013-2018年，粤东西北地区生产总值同比增速最快的年份”，答案应为2016年，但选项中无此年份，故解析以选项中的四个年份进行比较。</p>"},{"n":14,"qid":"2385098","tag":"综合","type":"single","stem":"2016年，广东各区域按社会消费品零售总额与地区生产总值的比值由大到小排列，依次为（    ）。","opts":[{"k":"A","t":"<p>珠三角<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ce99f935fdbe4b33.png\" />粤北山区<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ce99f935fdbe4b33.png\" />东翼<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ce99f935fdbe4b33.png\" />西翼</p>"},{"k":"B","t":"<p>珠三角<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ce99f935fdbe4b33.png\" />粤北山区<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ce99f935fdbe4b33.png\" />西翼<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ce99f935fdbe4b33.png\" />东翼</p>"},{"k":"C","t":"<p>东翼<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ce99f935fdbe4b33.png\" />西翼<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ce99f935fdbe4b33.png\" />珠三角<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ce99f935fdbe4b33.png\" />粤北山区</p>"},{"k":"D","t":"<p>东翼<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ce99f935fdbe4b33.png\" />西翼<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ce99f935fdbe4b33.png\" />粤北山区<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ce99f935fdbe4b33.png\" />珠三角</p>"}],"ans":["D"],"missing":false,"analysis":"<p>由题干“2016年···与···的比值由大到小排列，依次为”，可判定本题为比值比较问题。定位表1可得2016年广东各区域社会消费品零售总额与地区生产总值，比值分别为：珠三角<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-2a4c7ea733d2dd02.png\" />、东翼<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ba1ebca3946a5a18.png\" />、西翼<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-db6c28dcffc326ab.png\" />、粤北山区<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-294c43ccb5b07d4d.png\" />。由大到小排列依次为东翼、西翼、粤北山区、珠三角，与D项顺序一致。</p><p>故正确答案为D。</p>"},{"n":15,"qid":"2385099","tag":"综合","type":"single","stem":"根据上表，下列说法正确的是（    ）。","opts":[{"k":"A","t":"2016年，珠三角地方一般公共预算收入比粤东西北地区多7.0倍"},{"k":"B","t":"2012-2018年，珠三角与粤东西北地区生产总值的差距逐年缩小"},{"k":"C","t":"按2018年珠三角地区生产总值的同比增速，预计2020年珠三角地区生产总值将突破9万亿元"},{"k":"D","t":"2016年，广东省固定资产投资30008.86亿元"}],"ans":["C"],"missing":false,"analysis":"<p>A项：定位表1可得，2016年珠三角地方一般公共预算收入为6923.98亿元，粤东西北地区为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-2692eabb0f6ed29c.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-92a5d34cd199f618.png\" />亿元。多7倍代表是8倍，<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-120f1ea791c2c6a0.png\" />倍<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-7f21c743043f359f.png\" />8倍，错误；</p><p>B项：定位表2可得，2012年珠三角与粤东西北地区生产总值分别为47824.18、12650.41亿元，<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-ec3fc580f8d2672f.png\" />亿元。2013年珠三角与粤东西北地区生产总值分别为53307.67、14149.40亿元，<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-3db1e1841bb0edfb.png\" />亿元。<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-d74680e059a2b0b8.png\" />，可知差距并非逐年缩小，错误；</p><p>C项：定位表2可得，2018年珠三角地区生产总值为81048.50亿元，2017年为75809.75亿元。2018年珠三角地区生产总值同比增量<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-75edbac446c48c9b.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-e8732ac2b3085aec.png\" />亿元。根据增长量与现期量成正比，保持增长率不变，则2020年的增长量<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-24bb221293f88a08.png\" />2019年的增长量<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-24bb221293f88a08.png\" />2018年的增长量，则2020年珠三角地区生产总值<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-24bb221293f88a08.png\" />2018年珠三角地区生产总值<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-2816dd7e21e621be.png\" />2018年的增长量<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-b952643403dc3c8c.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-1d8e6da4ee584478.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-667156d61ad53d2f.png\" />亿元，正确；</p><p>D项：定位表1可得，2016年，广东省固定资产投资为<img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-9ce8e05b9412ae6e.png\" /><img flag=\"tex\" src=\"https://raw.githubusercontent.com/ERRRC/xingcezhenti/main/90-%E5%9B%BE%E7%89%87/%E5%85%AC%E5%BC%8F%E5%9B%BE/formula-d97049322bafc5c8.png\" />亿元，错误。</p><p>故正确答案为C。</p>"}]}]}